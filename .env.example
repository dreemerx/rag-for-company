# ==================== LLM 配置 ====================
# cloud 或 local
LLM_PROVIDER=cloud

# 云端 LLM (MiMo)
MIMO_API_KEY=your-mimo-api-key
MIMO_API_BASE=https://api.mimo.com/v1
MIMO_MODEL_NAME=mimo-chat

# 本地 LLM (Qwen)
LOCAL_MODEL_PATH=/models/qwen
LOCAL_MODEL_PORT=8000
LOCAL_MODEL_NAME=qwen-chat

# ==================== 向量数据库 ====================
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=company_knowledge

# ==================== JWT 认证 ====================
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== 数据库 ====================
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ==================== 限流配置 ====================
RATE_LIMIT_PER_MINUTE=20
TOKEN_LIMIT_PER_SESSION=50000

# ==================== 知识库 ====================
KNOWLEDGE_BASE_DIR=./data/knowledge_base

# ==================== 评测 ====================
EVAL_ACCURACY_THRESHOLD=0.85

# ==================== 服务配置 ====================
HOST=0.0.0.0
PORT=8000
DEBUG=false
