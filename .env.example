# LLM 配置
LLM_PROVIDER=cloud

# 云端 LLM (MiMo)
MIMO_API_KEY=your_api_key_here
MIMO_API_BASE=https://api.mimo.com/v1
MIMO_MODEL_NAME=mimo-chat

# 本地 LLM (Qwen)
LOCAL_MODEL_PATH=/models/qwen
LOCAL_MODEL_PORT=8000
LOCAL_MODEL_NAME=qwen-chat

# Milvus 向量数据库
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=company_knowledge
MILVUS_DIMENSION=512

# Embedding 模型（必须与 MILVUS_DIMENSION 匹配）
# BAAI/bge-small-zh-v1.5 -> 512 维
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# Reranker 模型
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=5

# 分块配置
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Hybrid Search 配置
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7

# JWT 认证（必须在生产环境修改！）
# 使用 python -c "import secrets; print(secrets.token_urlsafe(32))" 生成
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# 限流配置
RATE_LIMIT_PER_MINUTE=20
TOKEN_LIMIT_PER_SESSION=50000

# 知识库
KNOWLEDGE_BASE_DIR=./data/knowledge_base

# 评测
EVAL_ACCURACY_THRESHOLD=0.85
RAGAS_FAITHFULNESS_THRESHOLD=0.7
RAGAS_RELEVANCE_THRESHOLD=0.7

# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=false

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=data/logs
